{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spray-net-home-show-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://benjamin41997-ctrl.github.io",
    "SUPABASE_URL": "https://qyjygiuqwuakluigzjze.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_9UoZslkrZFfV2sd6QHBTcA_iDeRqxVR",
    "OWNER_EMAIL": "ben.hessler@spray-net.com",
    "EVENT_ID": "home-show-2026-10",
    "FREE_RENDERS": "5",
    "RENDER_ENABLED": "true",
    "DAILY_RENDER_LIMIT": "50",
    "PHONE_RENDER_ATTEMPT_LIMIT": "10",
    "EVENT_RENDER_LIMIT": "500",
    "LEADS_PER_IP_HOUR": "300",
    "CONSENT_VERSION": "2026-10-21-v1",
    "OPENAI_IMAGE_MODEL": "gpt-image-2.5-sunburst",
    "RENDER_TIMEOUT_MS": "90000",
    "OUTLOOK_CALENDAR_USER": "ben.hessler@spray-net.com",
    "BOOKING_DURATION_MINUTES": "90",
    "BOOKING_BUFFER_MINUTES": "30",
    "BOOKING_PROVIDER": "internal",
    "BOOKING_WORK_DAYS": "0,1,2,3,4,5,6",
    "BOOKING_WORK_START": "08:00",
    "BOOKING_WORK_END": "19:00",
    "BOOKING_START_DATE": "2026-10-26",
    "BOOKING_END_DATE": "2026-11-08",
    "BOOKING_HORIZON_DAYS": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spray-net-home-show",
      "database_id": "31855582-89b5-4359-b1cd-5dea17aa41b3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "spray-net-home-show-private"
    }
  ],
  "observability": {
    "enabled": false
  },
